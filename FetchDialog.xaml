<Window x:Class="BoomCrashBacktester.FetchDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Download Data" Height="320" Width="420"
        Background="White" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock x:Name="ContextText" FontWeight="Bold" Margin="0,0,0,12" Foreground="#202020"/>

        <TextBlock Text="Range:" Margin="0,0,0,4" Foreground="#202020"/>
        <ComboBox x:Name="RangeCombo" SelectionChanged="RangeCombo_SelectionChanged" Margin="0,0,0,8"/>

        <StackPanel x:Name="CustomDaysPanel" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,0,8">
            <TextBlock Text="Last" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="CustomDaysBox" Width="50" Text="3" TextChanged="CustomDaysBox_TextChanged"/>
            <TextBlock Text="days" VerticalAlignment="Center" Margin="6,0,0,0"/>
        </StackPanel>

        <Border Background="#F5F5F5" Padding="10" Margin="0,4,0,12">
            <TextBlock x:Name="EstimateText" TextWrapping="Wrap" Foreground="#404040" FontSize="12"/>
        </Border>

        <ProgressBar x:Name="ProgressBar" Height="18" Minimum="0" Maximum="100" Margin="0,0,0,6"/>
        <TextBlock x:Name="ProgressStatusText" Foreground="#606060" FontSize="12" Margin="0,0,0,12"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" Content="Cancel" Width="80" Margin="0,0,8,0" Click="CancelButton_Click"/>
            <Button x:Name="DownloadButton" Content="Download" Width="90" Click="DownloadButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
